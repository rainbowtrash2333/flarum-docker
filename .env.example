# Flarum 配置
FLARUM_BASE_URL=http://localhost:8080
FLARUM_FORCE_HTTPS=false

# 数据库配置
DB_ROOT_PASSWORD=change-me
DB_NAME=flarum
DB_USER=flarum_user
DB_PASSWORD=change-me

# Redis 配置
REDIS_HOST=cache
REDIS_PORT=6379

# LLM API Key 现通过 Flarum Admin 后台配置
# 路径: Admin → Extensions → Translate → Settings → LLM API Key
# 对应 setting: twikura-translate.llm_api_key
